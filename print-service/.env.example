# Use local para teste de impressora sem pedidos, ou hml para receber pedidos Pix aprovados.
MODE=local

# Use exatamente o nome exibido pelo Windows em Configurações > Impressoras e scanners.
PRINTER_NAME=MP-4200 HS
NODE_ENV=development

# Estado local persistente. Caminho relativo à pasta print-service.
STATE_FILE=./data/print-state.json
PRINT_RETRY_SECONDS=60
PRINT_TIMEOUT_SECONDS=30
PAPER_COLUMNS=42
ENABLE_PAPER_CUT=true

# Necessário somente no MODE=hml. O segredo é usado uma única vez para parear este PC.
HML_API_URL=https://jg-cardapio-api-hml.jg-hamburgueria-cardapio.workers.dev
PRINT_PAIRING_SECRET=
PRINT_DEVICE_NAME=Caixa HML
PRINT_POLL_SECONDS=3

