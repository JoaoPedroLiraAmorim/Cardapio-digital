# local não usa rede. hml e production consomem somente o Worker autorizado.
MODE=local

# Use exatamente o nome exibido pelo Windows em Configurações > Impressoras e scanners.
PRINTER_NAME=MP-4200 HS
NODE_ENV=development

# Estado local persistente. Caminho relativo à pasta print-service.
STATE_FILE=./data/print-state.json
PRINT_RETRY_SECONDS=60
PRINT_TIMEOUT_SECONDS=30
PAPER_COLUMNS=42
ENABLE_PAPER_CUT=true
# Quantidade de vias por comanda. Use 2 apenas durante o teste solicitado.
PRINT_COPIES=1

# Para HML:
HML_API_URL=https://jg-cardapio-api-hml.jg-hamburgueria-cardapio.workers.dev
# Para produção, troque MODE para production e use somente:
# API_URL=https://jg-cardapio-api-prod.jg-hamburgueria-cardapio.workers.dev
DEVICE_NAME=caixa-01

# Informe somente durante `npm run hml:pair`; não deixe este segredo no .env.
# PRINT_PAIRING_SECRET=
