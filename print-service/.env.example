# Primeiro teste: mantenha false. Depois de configurar o Firestore, altere apenas para true.
ENABLE_FIREBASE=false

# Use exatamente o nome exibido pelo Windows em Configurações > Impressoras e scanners.
PRINTER_NAME=MP-4200 HS
NODE_ENV=development

# Estado local persistente. Caminho relativo à pasta print-service.
STATE_FILE=./data/print-state.json
PRINT_RETRY_SECONDS=60
PRINT_TIMEOUT_SECONDS=30
PAPER_COLUMNS=42
ENABLE_PAPER_CUT=true

# Firebase Admin. Prefira apontar para o JSON da conta de serviço fora do repositório.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_COLLECTION=printJobs

